# 9router Configuration
NINEROUTER_INITIAL_PASSWORD=change_this_to_a_secure_password
NINEROUTER_JWT_SECRET=change_this_to_a_random_jwt_secret_string

# 9router is published only on this IP (Docker ports bypass UFW). Get it with: tailscale ip -4
TAILSCALE_IP=

# Headroom is internal-only; no proxy token or published port.

# Butler dashboard authentication and browser origin.
BUTLER_LOGIN=you@example.com
BUTLER_ORIGIN=https://<host>.<tailnet>.ts.net:8444
BUTLER_WEB_ORIGIN=https://<host>.<tailnet>.ts.net:8444
