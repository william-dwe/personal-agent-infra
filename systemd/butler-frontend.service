[Unit]
Description=Butler dashboard (Next.js) on 127.0.0.1:3100
Wants=butler-backend.service
After=butler-backend.service

[Service]
Type=simple
User=hermes
Group=hermes
UMask=0007
EnvironmentFile=-/home/ubuntu/services/personal-agent-infra/.env
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 BUTLER_API=http://127.0.0.1:8765 HOME=/tmp
WorkingDirectory=/home/hermes/services/butler/frontend
ExecStart=/home/hermes/.hermes/node/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3100
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
BindReadOnlyPaths=/home/hermes/.hermes/node /home/hermes/services/butler/frontend
BindPaths=-/home/hermes/services/butler/frontend/.next/cache
# V8 JIT needs executable writable memory.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
